{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Asker M5 SLO overview: query latency P90/P50 (5s hard SLO), error/cache/degradation, ingest freshness (30-min SLO), pipeline throughput, and the zero-data-loss dead-letter signal. Metric names + labels per the M5 wave-1 shared facts (no tenant/doc labels by design).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["asker", "slo", "m5"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "Query mode",
        "multi": true,
        "name": "mode",
        "options": [],
        "query": "label_values(asker_query_search_duration_milliseconds_bucket, mode)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" }
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "Pipeline stage",
        "multi": true,
        "name": "stage",
        "options": [],
        "query": "label_values(asker_pipeline_records_total, stage)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Asker SLO Overview",
  "uid": "asker-slo-overview",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "type": "row",
      "title": "Query latency (SLO: P90 <= 5s, design P50 <= 800ms)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Query latency P90 vs 5s SLO",
      "description": "End-to-end query P90 latency (histogram_quantile over asker_query_search_duration_milliseconds_bucket), summed by le across the selected modes. The red 5000 ms line is the HARD SLO (spec §2.7).",
      "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 5000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.9, sum by (le) (rate(asker_query_search_duration_milliseconds_bucket{mode=~\"$mode\"}[$__rate_interval])))",
          "legendFormat": "P90"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Query latency P50 vs 800ms target",
      "description": "Query P50 latency. The orange 800 ms line is the design target (spec §2.7), not a hard SLO.",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 800 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(asker_query_search_duration_milliseconds_bucket{mode=~\"$mode\"}[$__rate_interval])))",
          "legendFormat": "P50"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Current query P90",
      "description": "Most recent query P90 over a 5m window. Green < 800ms (design), yellow approaching, red >= 5000ms (SLO breach).",
      "id": 3,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 800 },
              { "color": "red", "value": 5000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.9, sum by (le) (rate(asker_query_search_duration_milliseconds_bucket[5m])))",
          "legendFormat": "P90"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Cache hit rate",
      "description": "asker_query_cache_requests_total: hits / total. Higher is better; the result cache protects the latency SLO.",
      "id": 4,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "green", "value": 0.6 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(asker_query_cache_requests_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(asker_query_cache_requests_total[5m])), 0.0001)",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Gateway 5xx ratio",
      "description": "http_server_requests_total{job=\"gateway\"}: 5xx / all. The public-API error rate; should be ~0.",
      "id": 5,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_total{job=\"gateway\",http_response_status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(http_server_requests_total{job=\"gateway\"}[5m])), 0.0001)",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Dead-letter rate (should be ~0)",
      "description": "asker_pipeline_deadletter_total summed across origin topics. The authoritative ZERO-DATA-LOSS signal (M5 soak exit). Any sustained nonzero value is a data-loss event.",
      "id": 6,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.0001 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(asker_pipeline_deadletter_total[5m]))",
          "legendFormat": "deadletter/s"
        }
      ]
    },
    {
      "type": "row",
      "title": "Query traffic, errors, cache & degradation",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Query rate (by mode) & gateway 5xx rate",
      "description": "Query throughput from the search histogram _count by mode, and the gateway 5xx error rate (http_server_requests_total).",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "gateway 5xx" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (mode) (rate(asker_query_search_duration_milliseconds_count{mode=~\"$mode\"}[$__rate_interval]))",
          "legendFormat": "query {{mode}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_total{job=\"gateway\",http_response_status_class=\"5xx\"}[$__rate_interval]))",
          "legendFormat": "gateway 5xx"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cache hit rate",
      "description": "asker_query_cache_requests_total: hits / (hits + misses) over time.",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(asker_query_cache_requests_total{result=\"hit\"}[$__rate_interval])) / clamp_min(sum(rate(asker_query_cache_requests_total[$__rate_interval])), 0.0001)",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Degradation events by rung",
      "description": "asker_query_degradation_events_total by rung (keyword-only, clip-unavailable). Queries are still answered (graceful degradation, never fail-closed); a spike means a backend is unhealthy.",
      "id": 9,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (rung) (rate(asker_query_degradation_events_total[$__rate_interval]))",
          "legendFormat": "{{rung}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Ingest freshness (SLO: source edit -> searchable <= 30 min)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 102,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Ingest freshness P90 vs 30-min SLO",
      "description": "P90 of asker_index_doc_age_seconds (now - Document.created_at at index time) — the end-to-end freshness proxy. The red 1800 s line is the 30-min SLA (spec §2.7).",
      "id": 10,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1800 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.9, sum by (le) (rate(asker_index_doc_age_seconds_bucket[$__rate_interval])))",
          "legendFormat": "freshness P90"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fraction of docs indexed within 30 min",
      "description": "Share of documents indexed within the freshness SLO: sum of asker_index_doc_age_seconds_bucket{le=\"1800\"} / total count. Target is ~1.0 (100%).",
      "id": 11,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(asker_index_doc_age_seconds_bucket{le=\"1800\"}[$__rate_interval])) / clamp_min(sum(rate(asker_index_doc_age_seconds_count[$__rate_interval])), 0.0001)",
          "legendFormat": "fraction <= 30 min"
        }
      ]
    },
    {
      "type": "row",
      "title": "Pipeline throughput & data loss",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "id": 103,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Pipeline throughput & attempt-failure rate by stage",
      "description": "asker_pipeline_records_total by stage: ok throughput (solid) and per-attempt error rate (dashed, result=error). Errors here are per handler attempt (kafkautil retries 3x), NOT dead-letters.",
      "id": 12,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*error.*" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (stage) (rate(asker_pipeline_records_total{stage=~\"$stage\",result=\"ok\"}[$__rate_interval]))",
          "legendFormat": "{{stage}} ok"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (stage) (rate(asker_pipeline_records_total{stage=~\"$stage\",result=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{stage}} error"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dead-letter rate by origin topic (~0 expected)",
      "description": "asker_pipeline_deadletter_total by origin_topic — the authoritative zero-data-loss signal (records newly quarantined to docs.deadletter). Steady state should be ~0; any sustained line means documents are not reaching the index.",
      "id": 13,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "decimals": 4,
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.0001 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (origin_topic) (rate(asker_pipeline_deadletter_total[$__rate_interval]))",
          "legendFormat": "{{origin_topic}}"
        }
      ]
    }
  ]
}
