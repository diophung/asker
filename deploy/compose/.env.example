# Asker dev-stack environment overrides (copy to deploy/compose/.env, which is
# gitignored). Every value here has a sane default baked into the compose file
# and the services; this file documents what you CAN override and is the
# reference the README points at. Never commit real secrets.

# --- Embeddings (ADR-005) ---------------------------------------------------
# Must match the model TEI serves AND the deployed Vespa schema. The dev stack
# (BAAI/bge-m3) uses 1024; CI overrides TEI_MODEL_ID to bge-small-en (384).
EMBEDDING_DIM=1024
# CLIP image/text space (ViT-B/32 => 512), ADR-013.
CLIP_DIM=512

# --- v3.2 Personalization (query service) -----------------------------------
# Master switch for the per-user re-rank. false => the non-personalized
# pipeline (a clean rollback; cold-start defaults still apply per user).
QUERY_PERSONALIZATION_ENABLED=true
# Fuse a keyword arm and a vector arm with Reciprocal Rank Fusion on the
# personalized path (spec §1.4). false => single-pass hybrid retrieval.
QUERY_HYBRID_RRF=true
# How many candidates the personalized path retrieves before re-ranking to the
# requested page (clamped to [100, 1000]).
QUERY_CANDIDATE_CAP=100
# "Most recent, most relevant first" freshness blend on the NON-personalized
# path, and the recency-bonus half-life used by the personalized re-rank.
QUERY_RECENCY_WEIGHT=0.4
QUERY_RECENCY_HALFLIFE=720h

# --- OAuth connector credentials (M2) ---------------------------------------
# Dev defaults point at the in-stack fake-oauth/fake-gmail. To talk to REAL
# providers, set the client id/secret AND drop the *_AUTH_URL/_TOKEN_URL so the
# connector hub uses the providers' real endpoints. NEVER commit real secrets.
# ASKER_OAUTH_GOOGLE_CLIENT_ID=
# ASKER_OAUTH_GOOGLE_CLIENT_SECRET=
# ASKER_OAUTH_MICROSOFT_CLIENT_ID=
# ASKER_OAUTH_MICROSOFT_CLIENT_SECRET=
# ASKER_OAUTH_SLACK_CLIENT_ID=
# ASKER_OAUTH_SLACK_CLIENT_SECRET=
# ASKER_OAUTH_ATLASSIAN_CLIENT_ID=
# ASKER_OAUTH_ATLASSIAN_CLIENT_SECRET=

# Allow the connector hub to dial private/loopback hosts (DEV ONLY, for the
# in-stack fake OAuth provider). NEVER set in production.
# ASKER_SAFEHTTP_ALLOW_PRIVATE=1
