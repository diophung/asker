# Canonical searchable document for Asker, M1.
#
# The content cluster runs in STREAMING mode (see ../services.xml): documents are
# stored in per-tenant groups and queries scan exactly one group. The indexing
# statements below do not build inverted indexes or attribute structures in
# streaming mode -- they select match modes (index => tokenized text matching,
# attribute => word matching) and summary inclusion.
#
# @EMBEDDING_DIM@ is a template token substituted by ../deploy.sh from the
# EMBEDDING_DIM environment variable (default 1024 for bge-m3; local dev .env
# uses 384). @CLIP_DIM@ is the analogous token for the CLIP image/text space
# (default 512 for ViT-B/32; M3, ADR-013), substituted from CLIP_DIM. This file
# is NOT a deployable schema until those substitutions run.
schema doc {

    document doc {

        field doc_id type string {
            indexing: summary | attribute
        }

        field connector_id type string {
            indexing: summary | attribute
        }

        field type type string {
            indexing: summary | attribute
        }

        field title type string {
            indexing: summary | index
        }

        field body type string {
            indexing: summary | index
        }

        # Unix epoch seconds.
        field created_at type long {
            indexing: summary | attribute
        }

        # Event OCCURRENCE time (v3.2), Unix epoch seconds; 0 for non-event docs.
        # Distinct from created_at (the authoring time): a calendar event created
        # months ago can occur next week, so "what's on my calendar next week"
        # MUST filter event_start, not created_at. The index-writer populates it
        # from the connector's metadata["start"]/["end"]; attribute => filterable
        # and sortable for the schedule-lookup intent (DECISIONS D11).
        field event_start type long {
            indexing: summary | attribute
        }

        field event_end type long {
            indexing: summary | attribute
        }

        # ~512-token chunks, 64-token overlap, structure-aware (spec section 2.4).
        # One string per chunk; the chunk's position in this array is the key of
        # its vector in the `embedding` tensor's mapped dimension ("0", "1", ...).
        field chunks type array<string> {
            indexing: summary | index
        }

        # One @EMBEDDING_DIM@-dim vector per chunk, keyed by the chunk array index.
        # - bfloat16 halves vector memory/disk vs float (spec section 2.7); cells
        #   are widened to float during the distance calculation, so a
        #   tensor<float> query tensor is the correct pairing.
        # - attribute only, deliberately no summary: vectors are ranking inputs,
        #   never response payload -- keeps summaries lean.
        # - distance-metric angular = cosine distance. TEI serves bge-m3 vectors
        #   L2-normalized, but angular stays correct even if normalization drifts
        #   (prenormalized-angular would silently mis-rank); in a streaming exact
        #   scan the extra norm computation is noise next to document-store IO.
        # - Streaming mode never builds HNSW: nearestNeighbor over this field is
        #   always an exact scan of the tenant's group, no index config needed.
        field embedding type tensor<bfloat16>(chunk{},x[@EMBEDDING_DIM@]) {
            indexing: attribute
            attribute {
                distance-metric: angular
            }
        }

        # CLIP image/text-space vectors (M3, ADR-013), one per chunk that carries
        # one (image / video-keyframe chunks). Same mixed-tensor shape and storage
        # rationale as `embedding`, but in a SEPARATE space (CLIP ViT-B/32,
        # @CLIP_DIM@-dim, default 512) that text and image encoders share -- it is
        # NOT comparable to bge-m3 `embedding`. The mapped `chunk` label is the
        # stringified index into the `chunks` array, exactly as for `embedding`.
        # - bfloat16 + attribute-only for the same reasons as `embedding`: vectors
        #   are ranking inputs, never summary payload.
        # - distance-metric angular = cosine; the clip service L2-normalizes both
        #   text and image vectors, so angular closeness is cosine (angular stays
        #   correct even if normalization drifts, unlike prenormalized-angular).
        # - Streaming mode never builds HNSW: nearestNeighbor over this field is an
        #   exact scan of the tenant group, identical to `embedding`.
        # - SPARSE per document: present only on chunks that have a CLIP vector, so
        #   the index-writer omits the whole field for text-only documents. A
        #   missing field yields closeness 0 -- the CLIP arm simply contributes
        #   nothing for that document, never an error.
        field clip_embedding type tensor<bfloat16>(chunk{},x[@CLIP_DIM@]) {
            indexing: attribute
            attribute {
                distance-metric: angular
            }
        }

        # Per-chunk time anchors (M3), parallel to the `chunks` array: index i here
        # is the start/end offset (ms) of chunks[i] within its source media, so a
        # search hit can deep-link to the moment (ADR-013). 0 for text/OCR chunks
        # (whole-document). attribute => available to ranking/grouping AND surfaced
        # in summaries so the query service can read the matched chunk's offset.
        field chunk_starts_ms type array<long> {
            indexing: summary | attribute
        }

        field chunk_ends_ms type array<long> {
            indexing: summary | attribute
        }

        # Per-chunk modality (M3), parallel to `chunks`: "text" | "ocr" | "asr" |
        # "caption". Lets the query service label a hit by what matched. attribute
        # (exact word match) + summary so the matched chunk's modality is readable.
        field chunk_modalities type array<string> {
            indexing: summary | attribute
        }

        # MediaInfo (M3, ADR-013) flattened onto the document; omitted/zero for
        # text docs. All summary|attribute: result-card payload that the query
        # service also exposes via Hit (thumbnail_key, duration, dimensions).
        # media_width/media_height are `long` here -- Vespa has no 32-bit attribute
        # type; the proto MediaInfo.width/height (int32) widen losslessly.
        field media_duration_ms type long {
            indexing: summary | attribute
        }

        field media_width type long {
            indexing: summary | attribute
        }

        field media_height type long {
            indexing: summary | attribute
        }

        # Blob key of the generated thumbnail / video poster frame (BlobRef key);
        # returned as Hit.thumbnail_key for the UI to render. Empty for text docs.
        field thumbnail_key type string {
            indexing: summary | attribute
        }

        # Detected ASR transcript language (BCP-47, e.g. "en"); empty for non-ASR.
        field transcript_lang type string {
            indexing: summary | attribute
        }

        # Participant display strings, e.g. "Alice Smith <alice@example.com>".
        # `index`, not `attribute`: in streaming mode, attribute means exact
        # whole-word matching on the untokenized value, while index gives
        # tokenized text matching ("alice" hits "Alice Smith <alice@example.com>")
        # AND query-time match annotations -- streaming supports
        # {substring:true}/{prefix:true}/{suffix:true} on index fields, which is
        # what the query service uses for participant= filtering.
        field participants type array<string> {
            indexing: summary | index
        }

        # Connector metadata (sender, channel, path, labels, ...) serialized as a
        # JSON object. Opaque to Vespa -- the query service parses it to build the
        # `metadata` map on result cards.
        field metadata_json type string {
            indexing: summary
        }

        # Unix epoch seconds.
        field modified_at type long {
            indexing: summary | attribute
        }

        # Source-provided etag for idempotent upserts; surfaced in summaries so
        # freshness can be verified end-to-end.
        field version_etag type string {
            indexing: summary | attribute
        }

        # ACL principal strings for shared sources (Drive, Confluence, ...).
        # attribute => exact word matching for filter terms; excluded from all
        # summary classes.
        field acl type array<string> {
            indexing: attribute
        }
    }

    fieldset default {
        fields: title, body, chunks
    }

    # M0-compatible default profile (used when no ranking= is given, e.g. by the
    # M0 smoke test). nativeRank does not depend on index-derived corpus
    # statistics, so it is meaningful in streaming mode. bm25 is deliberately NOT
    # used -- in streaming mode it requires significance / average-field-length
    # configuration to be meaningful.
    rank-profile default {
        first-phase {
            expression: nativeRank(title, body)
        }
    }

    # mode=keyword: text-only ranking over everything the default fieldset
    # searches. Streaming-safe for the same reasons as `default`.
    rank-profile keyword {
        first-phase {
            expression: nativeRank(title, body, chunks)
        }
    }

    # mode=hybrid: linear blend of keyword score and vector closeness.
    # - query(q) is the TEI query embedding, passed as input.query(q)=[...] and
    #   declared float: bfloat16 document cells widen to float for the distance
    #   computation.
    # - closeness(field, embedding) = 1/(1+distance) in [0,1]; for this mixed
    #   tensor (multiple vectors per document) the CLOSEST chunk vector is used,
    #   i.e. max closeness over the mapped `chunk` dimension. Documents matched
    #   by keyword only (no embedding / outside nearestNeighbor targetHits) get
    #   closeness 0 and rank on the keyword term alone.
    # - Weight defaults are declared as input defaults (Vespa 8 `inputs` section;
    #   this replaces the legacy rank-properties query() defaults) and can be
    #   overridden per query: input.query(keywordWeight)=0.7 etc.
    rank-profile hybrid {
        inputs {
            query(q) tensor<float>(x[@EMBEDDING_DIM@])
            query(keywordWeight) double: 0.5
            query(vectorWeight) double: 0.5
        }
        first-phase {
            expression: query(keywordWeight) * nativeRank(title, body, chunks) + query(vectorWeight) * closeness(field, embedding)
        }
    }

    # mode/arm=clip (M3, ADR-013): the text->image arm. The query service encodes
    # the query text with the CLIP *text* encoder (services/clip /embed/text) and
    # runs nearestNeighbor(clip_embedding, qclip); this profile ranks purely by
    # CLIP closeness. The query service runs this as a SEPARATE Vespa query (its
    # own ranking=clip + YQL nearestNeighbor over clip_embedding) and merges the
    # hits with the bge-m3 text/hybrid arm in-process, deduping by doc_id (the two
    # arms live in different vector spaces, so they are not blended inside one
    # Vespa expression). Degradation (ADR-006): clip service down -> the query
    # service drops this arm entirely; the text/OCR/ASR arm still answers.
    # - query(qclip) is the CLIP query embedding (input.query(qclip)=[...]),
    #   declared float so the bfloat16 document cells widen for the distance calc.
    # - closeness(field, clip_embedding) = 1/(1+angular_distance) in [0,1]; for the
    #   mixed chunk tensor the CLOSEST chunk vector per document is used (max over
    #   the mapped `chunk` dimension), exactly like closeness(field, embedding).
    # - closest(clip_embedding) is exposed in summary-features (see below) so the
    #   query service can read WHICH chunk matched -> its start_ms/modality.
    rank-profile clip {
        inputs {
            query(qclip) tensor<float>(x[@CLIP_DIM@])
        }
        first-phase {
            expression: closeness(field, clip_embedding)
        }
        # closest(clip_embedding) returns a mapped tensor with a single cell whose
        # LABEL is the chunk index of the document vector nearest to query(qclip)
        # (Vespa "closest(name)" rank feature). Surfaced per hit in
        # fields.summaryfeatures so the query service resolves the matched chunk ->
        # chunk_starts_ms[index] / chunk_ends_ms[index] / chunk_modalities[index].
        # summary-features are global to the active rank-profile and returned for
        # every hit regardless of the selected document-summary class.
        summary-features {
            closest(clip_embedding)
        }
    }

    # Summary class for the query service (&presentation.summary=search): lean
    # result-card fields plus dynamic summaries of body and chunks -- extracted
    # fragments around matching query terms, terms wrapped in <hi>...</hi>.
    # `dynamic` is supported for string and array<string> index fields (for
    # array<string>, an abstract is generated per element), and dynamic
    # summaries work in streaming mode (they are not among the documented
    # streaming-search limitations; teasers originated there).
    # The dynamic fields MUST use distinct names + `source:`: reusing the field
    # name (e.g. `summary body { dynamic }`) is rejected at deploy time --
    # "a field with the same name can not have different transforms in
    # different summary classes" (body/chunks are `full` in the default class).
    # The embedding tensor and acl are intentionally absent from every summary
    # class. Note: `body`/`chunks` raw values are NOT in this class -- the query
    # service falls back to the default summary if it ever needs full text.
    document-summary search {
        summary doc_id {}
        summary connector_id {}
        summary type {}
        summary title {}
        summary created_at {}
        summary event_start {}
        summary event_end {}
        summary modified_at {}
        summary version_etag {}
        summary participants {}
        summary metadata_json {}
        summary snippet {
            source: body
            dynamic
        }
        summary chunk_snippets {
            source: chunks
            dynamic
        }
        # Matched-chunk resolution (M3, ADR-013). The query service maps a hit's
        # matched chunk index -> time anchor + modality using these parallel
        # arrays. The index comes from:
        #   - CLIP arm: summaryfeatures["closest(clip_embedding)"] -- the single
        #     cell label is the chunk index (see the `clip` rank-profile).
        #   - text/ASR arm: chunk_snippets -- the element(s) carrying <hi> mark the
        #     matched chunk; its position is the index.
        # Both arrays are positionally aligned with `chunks`. Index 0 (text/OCR
        # whole-doc chunks) yields start/end 0.
        summary chunk_starts_ms {}
        summary chunk_ends_ms {}
        summary chunk_modalities {}
        # Media result-card fields (Hit.thumbnail_key etc.); zero/empty for text.
        summary media_duration_ms {}
        summary media_width {}
        summary media_height {}
        summary thumbnail_key {}
        summary transcript_lang {}
    }
}
